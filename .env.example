# Use sanitized local fixtures without calling external providers.
USE_MOCK_DATA=true
NEXT_PUBLIC_USE_MOCK_DATA=true
MOCK_DELAY_MS=500

# Allows a request-level useMock flag outside production when explicitly enabled.
ALLOW_REQUEST_MOCK=false

# Live mode stays locked until explicitly enabled with durable protection.
LIVE_SEARCH_ENABLED=false

# Durable cache and quota protection. Vercel KV_REST_API_* aliases are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional; Redis token is used as the HMAC key when this is empty.
LIVE_SEARCH_HASH_SECRET=

# Conservative limits for a 250-search SerpApi plan.
LIVE_SEARCH_PER_IP_MINUTE=2
LIVE_SEARCH_PER_IP_DAILY=10
LIVE_SEARCH_GLOBAL_MINUTE=4
LIVE_SEARCH_DAILY_BUDGET=20
LIVE_SEARCH_LIFETIME_BUDGET=50
LIVE_SEARCH_CACHE_TTL_SECONDS=86400

# Required only when live mode is enabled.
SERPAPI_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
