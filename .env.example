# Use sanitized local fixtures without calling external providers.
USE_MOCK_DATA=true
NEXT_PUBLIC_USE_MOCK_DATA=true
MOCK_DELAY_MS=500

# Allows request-level mock mode outside production when explicitly enabled.
ALLOW_REQUEST_MOCK=false

# Required only when USE_MOCK_DATA=false.
SERPAPI_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
